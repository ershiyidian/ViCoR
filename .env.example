# OpenAI-compatible VLM endpoints (single endpoint or dual main/reflex endpoints)
VICOR_ENDPOINT=http://127.0.0.1:8000/v1/chat/completions
VICOR_REFLEX_ENDPOINT=http://127.0.0.1:8001/v1/chat/completions
VICOR_MODEL=Qwen3-VL-30B-A3B
# OPENAI_API_KEY=your-api-key-if-needed

# Benchmark paths (populated by scripts/env_setup/*.sh)
VICOR_GAMEWORLD_ROOT=./local/gameworld/GameWorld
AIGAMESTORE_GAMES_ROOT=./local/aigamestore/gym/aigamestore
OMNIGAMEARENA_ROOT=./local/omnigamearena/OmniGameArena
OGA_UE5_SH=./local/omnigamearena/Linux/OmniGameArena.sh
ARC3_ENVIRONMENTS_DIR=./local/arc3/environments_dir
ROBODOJO_WS_DIR=./local/robodojo
